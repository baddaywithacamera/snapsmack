#!/usr/bin/env python3
"""
Pre-commit hook — rejects staged PHP files that contain null bytes or fail
PHP syntax check (php -l). Both are silent artifacts of the Cowork VM edit
tool: null bytes corrupt output, truncation breaks PHP parsing.

Install once:
    git config core.hooksPath .githooks
"""

import subprocess, sys, shutil

result = subprocess.run(
    ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'],
    capture_output=True, text=True
)

php_files = [f for f in result.stdout.splitlines() if f.endswith('.php')]
null_dirty = []
syntax_dirty = []
php_available = shutil.which('php') is not None

for path in php_files:
    try:
        with open(path, 'rb') as fh:
            if b'\x00' in fh.read():
                null_dirty.append(path)
                continue  # no point linting a null-byte file
    except OSError:
        pass

    if php_available:
        lint = subprocess.run(
            ['php', '-l', path],
            capture_output=True, text=True
        )
        if lint.returncode != 0:
            syntax_dirty.append((path, lint.stderr.strip() or lint.stdout.strip()))

blocked = bool(null_dirty or syntax_dirty)

# Skin policy changes and staged skin files must pass the repository ratchet.
skin_policy_dirty = []
staged = result.stdout.splitlines()
needs_skin_gate = any(
    p.startswith('skins/') or p in {
        'core/skin-security-policy.php', 'core/skin-security-legacy.php'
    } for p in staged
)
if needs_skin_gate:
    if not php_available:
        skin_policy_dirty.append('php is unavailable; skin policy cannot be verified')
    else:
        # Two-sided gate (SECAUDIT 060 finding A): forbidden authority must be
        # absent AND required presentation behaviour must still be present.
        for program in (
            'tests/skin-security-ratchet-regression.php',
            'tests/skin-parity-ratchet-regression.php',
            # One skin version must mean one set of files, or the sites that
            # already installed that version can never receive the change.
            'tests/skin-version-content-regression.php',
        ):
            gate = subprocess.run(['php', program], capture_output=True, text=True)
            if gate.returncode != 0:
                skin_policy_dirty.append(gate.stderr.strip() or gate.stdout.strip())
blocked = blocked or bool(skin_policy_dirty)

# The agreed-rules gate, on staged core/ and skins/ paths.
#
# It was written for Sean's "you two keep doing things we have agreed not to
# over and over" and then wired to nothing: not here, and not in the release
# flow, whose glob wanted *regression.php. It had been red since 0.7.933D
# without failing a build. A mechanism nobody runs is a note.
#
# --commit asks for TWO SEVERITIES, and this hook BLOCKS on the source rules.
#
# The first version of this ran the whole gate and blocked on nothing, because
# the gate is legitimately red for the whole time a build number is open and a
# hook that refuses every commit until a release lands gets switched off inside
# a day. Codex's review of 85239f9c showed that reasoning only covers the
# VERSION checks: it was letting a release-bookkeeping complaint silence a
# stray-byte one. Severity is now split in the gate itself.
#
#   --commit  source rules (UTF-8, and the boundary rules as they land) are
#             FATAL and block the commit; release-readiness items print but do
#             not block, because they are the expected state of an open build.
#   release   tools/release-flow.php RF_NAMED_GATES runs it with no flag, so
#             everything is fatal there.
# TRIGGERED BY ANY STAGED FILE, not by a path prefix or an extension list.
#
# It first triggered on staged core/ or skins/ paths only, which is what Sean
# specified. Measuring it showed the mismatch: rule 7 scans 2,205 tracked
# text-source files and only 333 of them are under core/ or skins/, so 1,872
# files were covered by a rule that could not trigger the check enforcing it. A
# bad byte in tools/, tests/ or a root file sailed past commit. Sean widened it
# on 3 November 2026.
#
# AND IT IS "ANY STAGED FILE" RATHER THAN "ANY STAGED SOURCE FILE" ON PURPOSE.
# Matching the gate's own extension list would mean a SECOND COPY of that list,
# in a different language, which is the drift that this repository keeps paying
# for -- the same fault as a rule defined once in PHP and once in SQL. The gate
# already decides what it scans; the hook only has to avoid MISSING. A commit
# of nothing but images costs one extra gate run, which is the cheaper mistake.
agreed_rules_block = ''
needs_agreed_rules = bool(staged)
if needs_agreed_rules and php_available:
    ar = subprocess.run(['php', 'tests/agreed-rules-gate.php', '--commit'],
                        capture_output=True, text=True)
    if ar.returncode != 0:
        agreed_rules_block = (ar.stderr.strip() or ar.stdout.strip())
    elif ar.stderr.strip():
        # Release-readiness notes on a passing commit: show them, do not block.
        print('\n\033[33m[pre-commit] release-readiness, not blocking this commit\033[0m')
        print(ar.stderr.strip())
blocked = blocked or bool(agreed_rules_block)

if null_dirty:
    print('\n\033[31m[pre-commit] NULL BYTES DETECTED — commit blocked\033[0m')
    print('Files with null bytes (Cowork VM edit artifact):')
    for f in null_dirty:
        print(f'  {f}')
    print('\nStrip with:')
    for f in null_dirty:
        print(f"  python3 -c \"d=open('{f}','rb').read(); open('{f}','wb').write(d.replace(b'\\x00',b''))\"")

if syntax_dirty:
    print('\n\033[31m[pre-commit] PHP SYNTAX ERRORS — commit blocked\033[0m')
    print('Files that failed php -l (truncated or broken):')
    for f, err in syntax_dirty:
        print(f'  {f}')
        for line in err.splitlines()[:3]:
            print(f'    {line}')

if skin_policy_dirty:
    print('\n\033[31m[pre-commit] SKIN SECURITY POLICY FAILED — commit blocked\033[0m')
    for err in skin_policy_dirty:
        print(err)

if not php_available:
    print('\n\033[33m[pre-commit] php not found in PATH — syntax check skipped\033[0m')

if agreed_rules_block:
    print('\n\033[31m[pre-commit] AGREED RULES GATE FAILED — commit blocked\033[0m')
    print(agreed_rules_block)
    print('\nThese are SOURCE rules, not release bookkeeping. An open build')
    print('number is not an excuse for them.\n')

if blocked:
    print('\nFix the issues above, re-stage, and commit.\n')
    sys.exit(1)

sys.exit(0)
