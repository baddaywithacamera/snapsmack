{
    "schema_version": 2,
    "security_policy": 2,
    "cms_controller": "smacktalk",
    "view_model": "snapsmack.public.v1",
    "templates": {
        "single": "layout.php",
        "feed": "layout.php",
        "archive": "layout.php",
        "not_found": "layout.php",
        "default": "layout.php"
    },
    "name": "ALFRED",
    "version": "1.0.28",
    "author": "Sean McCormick",
    "author_email": "sean@baddaywithacamera.ca",
    "description": "A SMACKTALK skin for photographers who write. Faithful recreation of Anders Norén's Hitchcock WordPress theme — dark navigation, Montserrat headings, Droid Serif body text, full-width header image. Named for Alfred Hitchcock.",
    "status": "stable",
    "modes": [
        "smacktalk"
    ],
    "variants": {
        "default": "Alfred (Dark Nav / White Content)"
    },
    "default_variant": "default",
    "cover_aspect": "1/1",
    "features": {
        "supports_wall": false,
        "has_landing": false,
        "post_modes": [
            "longform"
        ],
        "instagram_mode": false,
        "carousel": false,
        "community": [
            "comments"
        ]
    },
    "require_scripts": [
        "smack-tag-infinite",
        "smack-alfred-nav",
        "smack-footer",
        "smack-community",
        "smack-mosaic"
    ],
    "social_dock": {
        "position": "inline",
        "default_color_mode": "light",
        "default_color_light": "#ffffff",
        "default_icon_style": "outline",
        "default_shadow": false
    },
    "community_comments": "1",
    "community_likes": "0",
    "community_reactions": "0",
    "options": {
        "header_image": {
            "section": "HEADER",
            "type": "image",
            "label": "Header Background Image",
            "default": "",
            "accept": "image/jpeg,image/png,image/webp",
            "help": "Full-width image displayed behind the site logo. Recommended: 1440×900px minimum. Leave blank for the default.",
            "hint": "Recommended 1440×900px or larger. Leave blank for the default."
        },
        "header_image_height": {
            "section": "HEADER",
            "type": "select",
            "label": "Header Image Height",
            "default": "100vh",
            "options": {
                "100vh": "Full screen",
                "640px": "Tall (640px)",
                "460px": "Medium (460px)",
                "320px": "Short (320px)"
            },
            "selector": ":root",
            "property": "--alfred-header-h",
            "help": "How tall the header background image area is."
        },
        "header_image_fit": {
            "section": "HEADER",
            "type": "select",
            "label": "Header Image Fit",
            "default": "cover",
            "options": {
                "cover": "Cover (fill the area, may crop)",
                "contain": "Contain (show the whole image, no crop)",
                "auto": "Actual size"
            },
            "selector": ":root",
            "property": "--alfred-header-fit",
            "help": "How the image fills the header area."
        },
        "header_logo": {
            "section": "HEADER",
            "type": "image",
            "label": "Custom Logo",
            "default": "",
            "accept": "image/jpeg,image/png,image/webp,image/svg+xml",
            "help": "Upload a logo image to replace the site title text. Transparent PNG recommended.",
            "hint": "Transparent PNG recommended."
        },
        "retina_logo": {
            "section": "HEADER",
            "type": "select",
            "label": "Retina Logo",
            "default": "0",
            "options": [
                "No",
                "Yes (display at half size)"
            ],
            "help": "If your logo is uploaded at 2x resolution, enable this to display it at half size for sharp rendering on retina screens."
        },
        "show_tagline": {
            "section": "HEADER",
            "type": "select",
            "label": "Show Tagline",
            "default": "1",
            "options": {
                "1": "Show",
                "0": "Hide"
            },
            "help": "Hide the site tagline under the logo/title (useful when your logo already includes it). The tagline still appears in RSS and social/SEO meta."
        },
        "accent_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Accent Colour",
            "default": "#1e73be",
            "selector": ":root",
            "property": "--alfred-accent",
            "help": "Used for links, buttons, hover states, and interactive elements."
        },
        "show_post_titles": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "label": "Always Show Post Titles in Archive",
            "default": "0",
            "options": [
                "On hover only",
                "Always visible"
            ]
        },
        "landing_layout": {
            "section": "LANDING",
            "type": "select",
            "label": "Landing Layout",
            "hint": "Square uses the shared SNAPSMACK mosaic engine as an even cropped grid. Default leaves the skin's own grid alone.",
            "default": "square",
            "options": {
                "default": "Skin default",
                "square": "Square (even cropped grid)"
            }
        },
        "landing_square_cols": {
            "section": "LANDING",
            "type": "range",
            "label": "Squares Across",
            "hint": "Choose 3-5 square photographs per row. The shared mosaic engine keeps every tile evenly cropped.",
            "enable_when": {
                "landing_layout": "square"
            },
            "default": "3",
            "min": "3",
            "max": "5",
            "step": "1",
            "selector": ".alfred-archive-grid",
            "property": "--alfred-square-cols"
        },
        "post_content_width": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Post Content Width (px)",
            "default": "800",
            "min": "480",
            "max": "1100",
            "selector": ".post-inner",
            "property": "width",
            "unit": "px"
        },
        "posts_per_page": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Posts Per Page (archive)",
            "default": "12",
            "min": "4",
            "max": "40"
        },
        "caption_color": {
            "section": "CAPTIONS",
            "type": "color",
            "label": "Caption Colour",
            "default": "#666666",
            "selector": "figcaption",
            "property": "color",
            "omit_if_default": true,
            "help": "The colour of the caption under a photograph. Left as it is, the skin's own shade is used."
        },
        "caption_size": {
            "section": "CAPTIONS",
            "type": "range",
            "label": "Caption Size (px)",
            "default": "14",
            "min": "10",
            "max": "24",
            "unit": "px",
            "selector": "figcaption",
            "property": "font-size",
            "help": "How large the caption text is."
        },
        "caption_style": {
            "section": "CAPTIONS",
            "type": "select",
            "label": "Caption Style",
            "default": "italic",
            "options": {
                "italic": "Italic",
                "normal": "Upright"
            },
            "selector": "figcaption",
            "property": "font-style",
            "help": "Whether captions are italic, as ALFRED has always set them, or upright."
        },
        "caption_gap": {
            "section": "CAPTIONS",
            "type": "range",
            "label": "Space Above Caption (px)",
            "default": "12",
            "min": "0",
            "max": "48",
            "unit": "px",
            "selector": "figcaption",
            "property": "padding-top",
            "help": "The gap between a photograph and its caption."
        },
        "caption_align": {
            "section": "CAPTIONS",
            "type": "select",
            "label": "Caption Alignment",
            "default": "inherit",
            "options": {
                "inherit": "Follow the post text",
                "left": "Left",
                "center": "Centred",
                "right": "Right"
            },
            "selector": "figcaption",
            "property": "text-align",
            "help": "Captions follow the post's own alignment unless you choose otherwise."
        }
    }
}
