{
    "schema_version": 1,
    "name": "SCROLL",
    "version": "0.1.5",
    "author": "Sean McCormick, Claude, OpenAI Codex",
    "description": "A solo photoblog skin with a typographic masthead and a proven Flickr-style justified parts wall. Built for photographs that refuse to show the whole damn car.",
    "status": "beta",
    "features": {
        "supports_wall": false,
        "supports_slider": false,
        "has_landing": true,
        "post_modes": ["image"],
        "instagram_mode": false,
        "carousel": false,
        "community": ["likes", "comments"],
        "archive_layouts": ["justified"]
    },
    "require_scripts": [
        "smack-footer",
        "smack-image-fade-load",
        "smack-lazyload",
        "smack-community",
        "smack-keyboard",
        "smack-grid-nav",
        "smack-grid-lightbox",
        "smack-lightbox"
    ],
    "community_comments": true,
    "community_likes": true,
    "community_reactions": false,
    "options": {
        "scroll_masthead_lines": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Landing Masthead (use | for a line break)",
            "default": "USED CAR|PARTS"
        },
        "scroll_byline_prefix": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Photographer Byline Prefix",
            "default": "PHOTOGRAPHY BY"
        },
        "scroll_masthead_angle": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Counterclockwise Tilt (degrees)",
            "default": "18",
            "min": "0",
            "max": "40",
            "selector": ":root",
            "property": "--scroll-title-angle",
            "unit": "deg"
        },
        "scroll_masthead_font": {
            "section": "MASTHEAD",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "no_size_slider": true,
            "label": "Masthead Font",
            "default": "Archivo Black",
            "selector": ".scroll-masthead, .scroll-horizontal-title",
            "property": "font-family"
        },
        "scroll_masthead_color": {
            "section": "MASTHEAD",
            "type": "color",
            "label": "Masthead Colour",
            "default": "#f4f4f4",
            "selector": ".scroll-masthead, .scroll-horizontal-title",
            "property": "color"
        },
        "scroll_masthead_size": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Landing Masthead Size",
            "default": "6",
            "min": "3",
            "max": "8",
            "step": "0.5",
            "selector": ":root",
            "property": "--scroll-title-size",
            "unit": "vw"
        },
        "main_canvas_width": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Wall Width (px)",
            "default": "1500",
            "min": "800",
            "max": "1920",
            "selector": ":root",
            "property": "--scroll-canvas-width",
            "unit": "px"
        },
        "scroll_row_height": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Photo Size / Wall Density",
            "default": "280",
            "min": "160",
            "max": "600",
            "selector": ":root",
            "property": "--scroll-row-height",
            "unit": "px"
        },
        "scroll_tile_gap": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Tile Spacing",
            "default": "0",
            "min": "0",
            "max": "25",
            "selector": ":root",
            "property": "--scroll-tile-gap",
            "unit": "px"
        },
        "scroll_corner_radius": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Image Corner Radius (px)",
            "default": "0",
            "min": "0",
            "max": "32",
            "selector": ":root",
            "property": "--scroll-corner-radius",
            "unit": "px"
        },
        "scroll_border_width": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Outside Border Width (px)",
            "default": "0",
            "min": "0",
            "max": "12",
            "selector": ":root",
            "property": "--scroll-border-width",
            "unit": "px"
        },
        "scroll_border_color": {
            "section": "PHOTO WALL",
            "type": "color",
            "label": "Outside Border Colour",
            "default": "#ffffff",
            "selector": ":root",
            "property": "--scroll-border-color"
        },
        "scroll_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Background",
            "default": "#353535",
            "selector": "body",
            "property": "background-color"
        },
        "scroll_text": {
            "section": "COLOURS",
            "type": "color",
            "label": "Text",
            "default": "#f4f4f4",
            "selector": "body",
            "property": "color"
        },
        "scroll_link": {
            "section": "COLOURS",
            "type": "color",
            "label": "Links",
            "default": "#f4f4f4",
            "selector": "a",
            "property": "color"
        },
        "scroll_link_hover": {
            "section": "COLOURS",
            "type": "color",
            "label": "Link Hover",
            "default": "#ff5a36",
            "selector": "a:hover",
            "property": "color"
        }
    }
}
