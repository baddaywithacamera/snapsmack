{
    "schema_version": 1,
    "name": "SCROLL",
    "version": "0.1.35",
    "author": "Sean McCormick, Claude, OpenAI Codex",
    "description": "A solo photoblog skin with a typographic masthead and a four-column photo wall that runs every picture at its native shape — portraits stand tallest. Built for photographs that refuse to show the whole damn car.",
    "status": "beta",
    "features": {
        "supports_wall": false,
        "supports_slider": false,
        "has_landing": true,
        "post_modes": [
            "image"
        ],
        "instagram_mode": false,
        "carousel": false,
        "community": [
            "likes",
            "comments"
        ],
        "archive_layouts": [
            "justified"
        ]
    },
    "require_scripts": [
        "smack-footer",
        "smack-image-fade-load",
        "smack-lazyload",
        "smack-community",
        "smack-keyboard",
        "smack-grid-nav",
        "smack-grid-lightbox",
        "smack-lightbox",
        "smack-columns"
    ],
    "community_comments": true,
    "community_likes": true,
    "community_reactions": false,
    "social_dock": {
        "position": "inline",
        "color_mode": "dark",
        "icon_style": "outline",
        "shadow": false
    },
    "options": {
        "scroll_masthead_lines": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Landing Masthead (use | for a line break)",
            "default": "USED CAR|PARTS"
        },
        "masthead_logo": {
            "section": "MASTHEAD",
            "type": "image",
            "label": "Masthead Logo (replaces the title text)",
            "hint": "Optional. When set, the tilted title text is replaced by this image on the landing AND static pages. Your masthead text stays in the page source, hidden, so the heading keeps its SEO and screen-reader value. The sticky bar still shows the text blog name. PNG/SVG-as-PNG/WebP."
        },
        "masthead_logo_height": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Masthead Logo Height (px)",
            "hint": "Height of the masthead logo (only applies when a logo is set).",
            "default": "120",
            "min": "40",
            "max": "300",
            "step": "4",
            "selector": ":root",
            "property": "--scroll-masthead-logo-h",
            "unit": "px"
        },
        "scroll_byline_prefix": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Photographer Byline Prefix",
            "default": "PHOTOGRAPHY BY"
        },
        "photographer_name": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Photographer Name",
            "default": ""
        },
        "scroll_byline_prefix_size": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Byline Prefix Size (rem)",
            "hint": "Font size of the small “PHOTOS BY” line at top left.",
            "default": "0.82",
            "min": "0.6",
            "max": "2.2",
            "step": "0.05",
            "selector": ":root",
            "property": "--scroll-byline-prefix-size",
            "unit": "rem"
        },
        "scroll_byline_name_size": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Photographer Name Size (rem)",
            "hint": "Font size of the photographer name line at top left.",
            "default": "0.82",
            "min": "0.6",
            "max": "2.2",
            "step": "0.05",
            "selector": ":root",
            "property": "--scroll-byline-name-size",
            "unit": "rem"
        },
        "scroll_masthead_angle": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Counterclockwise Tilt (degrees)",
            "default": "18",
            "min": "0",
            "max": "40",
            "selector": ":root",
            "property": "--scroll-title-angle",
            "unit": "deg"
        },
        "scroll_masthead_font": {
            "section": "MASTHEAD",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "no_size_slider": true,
            "label": "Masthead Font",
            "hint": "The big tilted landing masthead AND the small blog-name running head in the sticky bar. Page titles have their own font below.",
            "default": "Archivo Black",
            "selector": ".scroll-masthead, .scroll-sticky-nav .ss-grid-nav-name, .scroll-horizontal-title",
            "property": "font-family"
        },
        "scroll_body_font": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "label": "Body / Metadata Font",
            "default": "DM Sans",
            "selector": "body, .scroll-infobox, #system-footer",
            "property": "font-family"
        },
        "scroll_header_font": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "label": "Solo Header Font",
            "default": "DM Sans",
            "selector": ".scroll-solo-header",
            "property": "font-family"
        },
        "scroll_pagetitle_font": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "label": "Static & Blog Heading Font",
            "hint": "Static/photo page titles AND blogroll section headings + names. Keep this sans-serif; set the body serif separately below. Independent of the masthead.",
            "default": "Archivo Black",
            "selector": ".scroll-horizontal-title, .blogroll-category-heading, .blogroll-peer-name",
            "property": "font-family"
        },
        "scroll_static_body_font": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "label": "Static & Blog Body Font",
            "hint": "Body/reading text on static pages and the blogroll — pick a serif here while the headings above stay sans-serif.",
            "default": "DM Sans",
            "selector": ".scroll-static-content .description, .blogroll-peer-desc",
            "property": "font-family"
        },
        "scroll_text_case": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "label": "Text Case",
            "default": "none",
            "options": {
                "none": "As Entered",
                "lowercase": "all lowercase",
                "uppercase": "ALL UPPERCASE"
            },
            "selector": ".scroll-solo-header, .scroll-infobox, .scroll-solo-title, #system-footer",
            "property": "text-transform"
        },
        "scroll_masthead_color": {
            "section": "MASTHEAD",
            "type": "color",
            "label": "Masthead Colour",
            "default": "#f4f4f4",
            "selector": ".scroll-masthead",
            "property": "color"
        },
        "scroll_masthead_size": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Landing Masthead Size",
            "default": "6",
            "min": "3",
            "max": "8",
            "step": "0.5",
            "selector": ":root",
            "property": "--scroll-title-size",
            "unit": "vw"
        },
        "scroll_bottomnav_size": {
            "section": "SOLO PAGE",
            "type": "range",
            "label": "Bottom Nav Font Size (rem)",
            "hint": "Size of the PREV / FIRST · INFO / COMMENTS · LAST / NEXT row under the solo photo.",
            "default": "0.75",
            "min": "0.6",
            "max": "1.6",
            "step": "0.05",
            "selector": ".scroll-infobox .nav-links",
            "property": "--scroll-bottomnav-size",
            "unit": "rem"
        },
        "scroll_masthead_pad": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Space Above & Below Masthead (px)",
            "hint": "Equal breathing room over and under the big landing title — grows and shrinks symmetrically.",
            "default": "32",
            "min": "0",
            "max": "160",
            "step": "2",
            "selector": ".scroll-profile",
            "property": "--scroll-masthead-pad",
            "unit": "px"
        },
        "scroll_nav_transparency": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Sticky Bar Opacity",
            "hint": "Opacity of the fixed nav bar that appears once you scroll past the masthead. 1 = solid, lower = see-through.",
            "default": "0.94",
            "min": "0",
            "max": "1",
            "step": "0.02",
            "selector": ":root",
            "property": "--scroll-nav-alpha"
        },
        "scroll_wall_cols": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Columns Across",
            "hint": "Number of columns in the landing wall. Default 4. Fewer = bigger photos; more = smaller.",
            "default": "4",
            "min": "3",
            "max": "6",
            "step": "1",
            "selector": ".ss-masonry",
            "property": "--ss-cols",
            "unit": ""
        },
        "scroll_canvas_pct": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Wall Width (% of window)",
            "hint": "Landing wall + header width as a percentage of the browser window, so it fits any screen resolution. The header icons/byline line up with the wall edges.",
            "default": "90",
            "min": "50",
            "max": "98",
            "selector": ":root",
            "property": "--scroll-canvas-pct",
            "unit": "%"
        },
        "main_canvas_width": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Photo Page Width (px)",
            "default": "1500",
            "min": "800",
            "max": "1920",
            "selector": ":root",
            "property": "--scroll-canvas-width",
            "unit": "px",
            "hint": "Max width of an individual photo/solo page (not the landing wall — that is set by Wall Width % above)."
        },
        "scroll_page_size": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Images Loaded Per Scroll",
            "default": "36",
            "min": "12",
            "max": "60",
            "step": "6",
            "unit": ""
        },
        "scroll_mosaic_gap": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Space Between Tiles (px)",
            "default": "6",
            "min": "5",
            "max": "25",
            "selector": ".ss-masonry",
            "property": "--ss-gap",
            "unit": "px"
        },
        "scroll_mosaic_emphasis": {
            "section": "PHOTO WALL",
            "type": "select",
            "label": "MOSAIC Hero Emphasis",
            "hint": "Controls which orientation is promoted into the largest cells on MOSAIC feeds. This does not change the saved library order.",
            "default": "landscape",
            "options": {
                "natural": "Follow Library Order",
                "balanced": "Balance Portraits & Landscapes",
                "landscape": "Favor Landscapes",
                "portrait": "Favor Portraits"
            }
        },
        "scroll_corner_radius": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Image Corner Radius (px)",
            "default": "0",
            "min": "0",
            "max": "32",
            "selector": ":root",
            "property": "--scroll-corner-radius",
            "unit": "px"
        },
        "scroll_border_width": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Outside Border Width (px)",
            "default": "0",
            "min": "0",
            "max": "12",
            "selector": ":root",
            "property": "--scroll-border-width",
            "unit": "px"
        },
        "scroll_border_color": {
            "section": "PHOTO WALL",
            "type": "color",
            "label": "Outside Border Colour",
            "default": "#ffffff",
            "selector": ":root",
            "property": "--scroll-border-color"
        },
        "scroll_image_pad": {
            "section": "SOLO PAGE",
            "type": "range",
            "label": "Whitespace Above & Below Photo (px)",
            "hint": "Vertical breathing room over and under a single photo. Equal top and bottom, so the photo stays centred.",
            "default": "50",
            "min": "0",
            "max": "160",
            "selector": ":root",
            "property": "--scroll-image-pad",
            "unit": "px"
        },
        "scroll_solo_text_width": {
            "section": "SOLO PAGE",
            "type": "range",
            "label": "Text Column Width (px)",
            "hint": "Width of the title and description text block under a photo.",
            "default": "850",
            "min": "500",
            "max": "1400",
            "selector": ":root",
            "property": "--scroll-solo-text-width",
            "unit": "px"
        },
        "scroll_solo_name_size": {
            "section": "SOLO PAGE",
            "type": "range",
            "label": "Blog Name Size (rem)",
            "hint": "Size of the blog name at the top-left of a solo photo page. The font follows the Masthead Font control.",
            "default": "1.05",
            "min": "0.7",
            "max": "2.4",
            "step": "0.05",
            "selector": ":root",
            "property": "--scroll-solo-name-size",
            "unit": "rem"
        },
        "scroll_static_width": {
            "section": "STATIC & BLOG",
            "type": "range",
            "label": "Text Column Width (px)",
            "hint": "Width of the text column on static pages (About, etc.) and the blogroll.",
            "default": "920",
            "min": "500",
            "max": "1400",
            "selector": ":root",
            "property": "--scroll-static-width",
            "unit": "px"
        },
        "scroll_hero_pad": {
            "section": "STATIC & BLOG",
            "type": "range",
            "label": "Hero Image Spacing — Top & Bottom (px)",
            "hint": "Vertical breathing room above and below the big image on a static page.",
            "default": "48",
            "min": "0",
            "max": "200",
            "selector": ":root",
            "property": "--scroll-hero-pad",
            "unit": "px"
        },
        "scroll_page_divider": {
            "section": "STATIC & BLOG",
            "type": "color",
            "label": "Top Divider Line Colour",
            "hint": "Thin line across static and blog pages, level with where the landing photo wall begins. Set it close to the background colour to hide it.",
            "default": "#999999",
            "selector": ":root",
            "property": "--scroll-page-divider"
        },
        "blogroll_columns": {
            "section": "STATIC & BLOG",
            "type": "select",
            "label": "Blogroll Columns",
            "default": "1fr",
            "options": {
                "1fr": "1 Column",
                "1fr 1fr": "2 Columns",
                "1fr 1fr 1fr": "3 Columns"
            },
            "selector": ".blogroll-grid",
            "property": "grid-template-columns"
        },
        "blogroll_col_gap": {
            "section": "STATIC & BLOG",
            "type": "range",
            "label": "Blogroll Gap (px)",
            "hint": "Space between blogroll entries (and between columns).",
            "default": "44",
            "min": "16",
            "max": "120",
            "selector": ".blogroll-grid",
            "property": "gap",
            "unit": "px"
        },
        "blogroll_show_desc": {
            "section": "STATIC & BLOG",
            "type": "select",
            "label": "Blogroll Descriptions",
            "default": "block",
            "options": {
                "block": "Shown",
                "none": "Hidden"
            },
            "selector": ".blogroll-peer-desc",
            "property": "display"
        },
        "blogroll_show_url": {
            "section": "STATIC & BLOG",
            "type": "select",
            "label": "Blogroll URLs",
            "hint": "The blog name is already a link, so the raw URL is hidden by default.",
            "default": "none",
            "options": {
                "none": "Hidden (name is the link)",
                "block": "Shown"
            },
            "selector": ".blogroll-peer-url",
            "property": "display"
        },
        "scroll_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Background",
            "default": "#ffffff",
            "selector": ":root",
            "property": "--scroll-bg"
        },
        "scroll_text": {
            "section": "COLOURS",
            "type": "color",
            "label": "Text",
            "default": "#3a3a3a",
            "selector": "body",
            "property": "color"
        },
        "scroll_link": {
            "section": "COLOURS",
            "type": "color",
            "label": "Links",
            "default": "#000000",
            "selector": "a",
            "property": "color"
        },
        "scroll_link_hover": {
            "section": "COLOURS",
            "type": "color",
            "label": "Link Hover",
            "default": "#555555",
            "selector": "a:hover",
            "property": "color"
        },
        "scroll_footer_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Footer Background",
            "default": "#ffffff",
            "selector": "#system-footer",
            "property": "background-color"
        },
        "scroll_footer_text": {
            "section": "COLOURS",
            "type": "color",
            "label": "Footer Text",
            "default": "#3a3a3a",
            "selector": ":root",
            "property": "--scroll-footer-text"
        },
        "scroll_navigation_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Solo Navigation Bar Background",
            "default": "#ffffff",
            "selector": ".scroll-infobox",
            "property": "background-color"
        },
        "scroll_modal_accent": {
            "section": "COLOURS",
            "type": "color",
            "label": "Help Overlay Accent",
            "hint": "Accent colour for the keyboard-help (F1) overlay — the key labels and title. Its panel and text already follow the page background and text colours.",
            "default": "#1a1a1a",
            "selector": ":root",
            "property": "--accent-color"
        }
    }
}
