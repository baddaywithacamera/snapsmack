{
    "schema_version": 1,
    "name": "SCROLL",
    "version": "0.2.0",
    "author": "Sean McCormick, Claude, OpenAI Codex",
    "description": "A solo photoblog skin with a typographic masthead and a four-column photo wall that runs every picture at its native shape — portraits stand tallest. Built for photographs that refuse to show the whole damn car.",
    "status": "beta",
    "features": {
        "supports_wall": false,
        "supports_slider": false,
        "has_landing": true,
        "post_modes": [
            "image"
        ],
        "instagram_mode": false,
        "carousel": false,
        "community": [
            "likes",
            "comments"
        ],
        "archive_layouts": [
            "justified"
        ]
    },
    "require_scripts": [
        "smack-footer",
        "smack-image-fade-load",
        "smack-lazyload",
        "smack-community",
        "smack-keyboard",
        "smack-grid-nav",
        "smack-grid-lightbox",
        "smack-lightbox",
        "smack-columns"
    ],
    "community_comments": true,
    "community_likes": true,
    "community_reactions": false,
    "options": {
        "scroll_masthead_lines": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Landing Masthead (use | for a line break)",
            "default": "USED CAR|PARTS"
        },
        "scroll_byline_prefix": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Photographer Byline Prefix",
            "default": "PHOTOGRAPHY BY"
        },
        "photographer_name": {
            "section": "MASTHEAD",
            "type": "text",
            "label": "Photographer Name",
            "default": ""
        },
        "scroll_masthead_angle": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Counterclockwise Tilt (degrees)",
            "default": "18",
            "min": "0",
            "max": "40",
            "selector": ":root",
            "property": "--scroll-title-angle",
            "unit": "deg"
        },
        "scroll_masthead_font": {
            "section": "MASTHEAD",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "no_size_slider": true,
            "label": "Masthead Font",
            "default": "Archivo Black",
            "selector": ".scroll-masthead, .scroll-horizontal-title",
            "property": "font-family"
        },
        "scroll_body_font": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "label": "Body / Metadata Font",
            "default": "DM Sans",
            "selector": "body, .scroll-infobox, #system-footer",
            "property": "font-family"
        },
        "scroll_header_font": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "is_font": true,
            "font_source": "google",
            "label": "Solo Header Font",
            "default": "DM Sans",
            "selector": ".scroll-solo-header",
            "property": "font-family"
        },
        "scroll_text_case": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "label": "Text Case",
            "default": "none",
            "options": {
                "none": "As Entered",
                "lowercase": "all lowercase",
                "uppercase": "ALL UPPERCASE"
            },
            "selector": ".scroll-solo-header, .scroll-infobox, .scroll-solo-title, #system-footer",
            "property": "text-transform"
        },
        "scroll_masthead_color": {
            "section": "MASTHEAD",
            "type": "color",
            "label": "Masthead Colour",
            "default": "#f4f4f4",
            "selector": ".scroll-masthead, .scroll-horizontal-title",
            "property": "color"
        },
        "scroll_masthead_size": {
            "section": "MASTHEAD",
            "type": "range",
            "label": "Landing Masthead Size",
            "default": "6",
            "min": "3",
            "max": "8",
            "step": "0.5",
            "selector": ":root",
            "property": "--scroll-title-size",
            "unit": "vw"
        },
        "main_canvas_width": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Wall Width (px)",
            "default": "1500",
            "min": "800",
            "max": "1920",
            "selector": ":root",
            "property": "--scroll-canvas-width",
            "unit": "px"
        },
        "scroll_page_size": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Images Loaded Per Scroll",
            "default": "36",
            "min": "12",
            "max": "60",
            "step": "6"
        },
        "scroll_mosaic_gap": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Space Between Tiles (px)",
            "default": "6",
            "min": "5",
            "max": "25",
            "selector": ".ss-masonry",
            "property": "--ss-gap",
            "unit": "px"
        },
        "scroll_corner_radius": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Image Corner Radius (px)",
            "default": "0",
            "min": "0",
            "max": "32",
            "selector": ":root",
            "property": "--scroll-corner-radius",
            "unit": "px"
        },
        "scroll_border_width": {
            "section": "PHOTO WALL",
            "type": "range",
            "label": "Outside Border Width (px)",
            "default": "0",
            "min": "0",
            "max": "12",
            "selector": ":root",
            "property": "--scroll-border-width",
            "unit": "px"
        },
        "scroll_border_color": {
            "section": "PHOTO WALL",
            "type": "color",
            "label": "Outside Border Colour",
            "default": "#ffffff",
            "selector": ":root",
            "property": "--scroll-border-color"
        },
        "scroll_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Background",
            "default": "#ffffff",
            "selector": "body",
            "property": "background-color"
        },
        "scroll_text": {
            "section": "COLOURS",
            "type": "color",
            "label": "Text",
            "default": "#3a3a3a",
            "selector": "body",
            "property": "color"
        },
        "scroll_link": {
            "section": "COLOURS",
            "type": "color",
            "label": "Links",
            "default": "#000000",
            "selector": "a",
            "property": "color"
        },
        "scroll_link_hover": {
            "section": "COLOURS",
            "type": "color",
            "label": "Link Hover",
            "default": "#555555",
            "selector": "a:hover",
            "property": "color"
        },
        "scroll_footer_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Footer Background",
            "default": "#ffffff",
            "selector": "#system-footer",
            "property": "background-color"
        },
        "scroll_footer_text": {
            "section": "COLOURS",
            "type": "color",
            "label": "Footer Text",
            "default": "#3a3a3a",
            "selector": "#system-footer",
            "property": "color"
        },
        "scroll_navigation_background": {
            "section": "COLOURS",
            "type": "color",
            "label": "Solo Navigation Bar Background",
            "default": "#ffffff",
            "selector": ".scroll-infobox",
            "property": "background-color"
        }
    }
}
