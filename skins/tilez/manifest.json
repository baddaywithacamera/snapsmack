{
    "schema_version": 2,
    "security_policy": 2,
    "name": "TILEZ",
    "version": "0.2.67",
    "author": "Sean McCormick & Claude",
    "author_email": "sean@baddaywithacamera.ca",
    "description": "A quiet white SMACKTALK portfolio inspired by editorial design studios. Longform posts flow through a native-aspect three-column wall powered by SnapSmack's shared columns engine.",
    "status": "beta",
    "modes": [
        "smacktalk"
    ],
    "cms_controller": "smacktalk",
    "view_model": "snapsmack.public.v1",
    "templates": {
        "single": "layout.php",
        "feed": "layout.php",
        "archive": "layout.php",
        "blogroll": "layout.php",
        "page": "layout.php",
        "not_found": "layout.php",
        "default": "layout.php"
    },
    "capabilities": [
        "navigation",
        "longform",
        "image-archive",
        "comments"
    ],
    "cms_navigation": [
        {"type": "home", "label": "HOME"},
        {"type": "blogroll", "label": "BLOGROLL"},
        {"type": "categories", "label": "CATEGORIES"},
        {"type": "albums", "label": "ALBUMS"},
        {"type": "image_archive", "label": "IMAGES"}
    ],
    "variants": {
        "default": "TILEZ (White Editorial Portfolio)"
    },
    "default_variant": "default",
    "cover_aspect": "native",
    "features": {
        "supports_wall": false,
        "has_landing": false,
        "post_modes": [
            "longform"
        ],
        "instagram_mode": false,
        "carousel": false,
        "community": [
            "comments"
        ]
    },
    "require_scripts": [
        "smack-alfred-nav",
        "smack-footer",
        "smack-image-fade-load",
        "smack-lazyload",
        "smack-tag-infinite",
        "smack-columns",
        "smack-rows",
        "smack-mosaic",
        "smack-lightbox",
        "smack-community",
        "smack-alfred-archive"
    ],
    "require_styles": [
        "asset:public:public-base",
        "asset:public:shortcodes",
        "asset:public:columns"
    ],
    "community_comments": "1",
    "community_likes": "0",
    "community_reactions": "0",
    "options": {
        "header_image": {
            "section": "HEADER",
            "type": "image",
            "label": "Header Background Image",
            "default": "",
            "accept": "image/jpeg,image/png,image/webp",
            "help": "Full-width image displayed behind the site logo. Recommended: 1440×900px minimum. Leave blank for the default.",
            "hint": "Recommended 1440×900px or larger. Leave blank for the default."
        },
        "header_image_height": {
            "section": "HEADER",
            "type": "select",
            "label": "Header Image Height",
            "default": "100vh",
            "options": {
                "100vh": "Full screen",
                "640px": "Tall (640px)",
                "460px": "Medium (460px)",
                "320px": "Short (320px)"
            },
            "selector": ":root",
            "property": "--alfred-header-h",
            "help": "How tall the header background image area is."
        },
        "header_image_fit": {
            "section": "HEADER",
            "type": "select",
            "label": "Header Image Fit",
            "default": "cover",
            "options": {
                "cover": "Cover (fill the area, may crop)",
                "contain": "Contain (show the whole image, no crop)",
                "auto": "Actual size"
            },
            "selector": ":root",
            "property": "--alfred-header-fit",
            "help": "How the image fills the header area."
        },
        "header_logo": {
            "section": "HEADER",
            "type": "image",
            "label": "Custom Logo",
            "default": "",
            "accept": "image/jpeg,image/png,image/webp,image/svg+xml",
            "help": "Upload a logo image to replace the site title text. Transparent PNG recommended.",
            "hint": "Transparent PNG recommended."
        },
        "retina_logo": {
            "section": "HEADER",
            "type": "select",
            "label": "Retina Logo",
            "default": "0",
            "options": [
                "No",
                "Yes (display at half size)"
            ],
            "help": "If your logo is uploaded at 2x resolution, enable this to display it at half size for sharp rendering on retina screens."
        },
        "show_tagline": {
            "section": "HEADER",
            "type": "select",
            "label": "Show Tagline",
            "default": "1",
            "options": {
                "1": "Show",
                "0": "Hide"
            },
            "help": "Hide the site tagline under the logo/title (useful when your logo already includes it). The tagline still appears in RSS and social/SEO meta."
        },
        "tilez_info_page_slug": {
            "section": "NAVIGATION",
            "type": "text",
            "label": "Info Page Slug",
            "default": "about",
            "help": "The static page opened by the round information icon, for example about or the-artist."
        },
        "accent_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Accent Colour",
            "default": "#1e73be",
            "selector": ":root",
            "property": "--alfred-accent",
            "help": "Used for links, buttons, hover states, and interactive elements."
        },
        "show_post_titles": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "label": "Always Show Post Titles in Archive",
            "default": "0",
            "options": [
                "On hover only",
                "Always visible"
            ]
        },
        "body_font_family": {
            "section": "TYPOGRAPHY",
            "type": "select",
            "label": "Post Body Font",
            "default": "Montserrat",
            "options": {
                "Montserrat": {"label": "Montserrat — Sans Serif", "css": "{ font-family: Montserrat, 'Helvetica Neue', Helvetica, Arial, sans-serif; }"},
                "Segoe UI": {"label": "Segoe UI — Sans Serif", "css": "{ font-family: 'Segoe UI', Arial, sans-serif; }"},
                "Arial": {"label": "Arial — Sans Serif", "css": "{ font-family: Arial, Helvetica, sans-serif; }"},
                "Helvetica Neue": {"label": "Helvetica Neue — Sans Serif", "css": "{ font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }"},
                "Verdana": {"label": "Verdana — Sans Serif", "css": "{ font-family: Verdana, Geneva, sans-serif; }"},
                "Tahoma": {"label": "Tahoma — Sans Serif", "css": "{ font-family: Tahoma, Verdana, sans-serif; }"},
                "Trebuchet MS": {"label": "Trebuchet MS — Sans Serif", "css": "{ font-family: 'Trebuchet MS', Arial, sans-serif; }"},
                "Calibri": {"label": "Calibri — Sans Serif", "css": "{ font-family: Calibri, 'Segoe UI', Arial, sans-serif; }"},
                "Century Gothic": {"label": "Century Gothic — Sans Serif", "css": "{ font-family: 'Century Gothic', Futura, Arial, sans-serif; }"},
                "Franklin Gothic Medium": {"label": "Franklin Gothic Medium — Sans Serif", "css": "{ font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif; }"},
                "Droid Serif": {"label": "Droid Serif — Serif", "css": "{ font-family: 'Droid Serif', Georgia, serif; }"},
                "Georgia": {"label": "Georgia — Serif", "css": "{ font-family: Georgia, 'Times New Roman', serif; }"},
                "Times New Roman": {"label": "Times New Roman — Serif", "css": "{ font-family: 'Times New Roman', Times, serif; }"},
                "Palatino Linotype": {"label": "Palatino Linotype — Serif", "css": "{ font-family: 'Palatino Linotype', Palatino, Georgia, serif; }"},
                "Book Antiqua": {"label": "Book Antiqua — Serif", "css": "{ font-family: 'Book Antiqua', Palatino, Georgia, serif; }"},
                "Baskerville": {"label": "Baskerville — Serif", "css": "{ font-family: Baskerville, Georgia, serif; }"},
                "Cambria": {"label": "Cambria — Serif", "css": "{ font-family: Cambria, Georgia, serif; }"},
                "Constantia": {"label": "Constantia — Serif", "css": "{ font-family: Constantia, Georgia, serif; }"},
                "Garamond": {"label": "Garamond — Serif", "css": "{ font-family: Garamond, Georgia, serif; }"},
                "Charter": {"label": "Charter — Serif", "css": "{ font-family: Charter, Georgia, serif; }"}
            },
            "selector": ".post-content, .entry-content",
            "property": "custom-font-family",
            "is_font": true,
            "no_size_slider": true,
            "help": "Choose the typeface used for article and page body copy. The sample updates as you browse the list."
        },
        "body_font_size": {
            "section": "TYPOGRAPHY",
            "type": "range",
            "label": "Post Body Font Size",
            "default": "20",
            "min": "14",
            "max": "28",
            "step": "1",
            "unit": "px",
            "selector": ".post-content, .entry-content",
            "property": "font-size",
            "help": "Set the article and page body-copy size in pixels."
        },
        "post_content_width": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Post Content Width (px)",
            "default": "800",
            "min": "480",
            "max": "1100",
            "selector": ".post-inner",
            "property": "width",
            "unit": "px"
        },
        "posts_per_page": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Posts Per Page (archive)",
            "default": "12",
            "min": "4",
            "max": "40"
        },
        "archive_columns": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Image Archive Columns",
            "default": "5",
            "min": "2",
            "max": "8",
            "selector": ".alfred-archive-grid",
            "property": "--ss-cols",
            "help": "Number of smaller native-aspect columns in the Images archive."
        },
        "archive_gap": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Image Archive Gap",
            "default": "4",
            "min": "0",
            "max": "24",
            "unit": "px",
            "selector": ".alfred-archive-grid",
            "property": "--ss-gap",
            "help": "Space between photographs in the Images archive."
        }
    }
}
