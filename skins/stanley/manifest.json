{
    "schema_version": 1,
    "name": "STANLEY",
    "version": "1.0.3",
    "author": "Sean McCormick",
    "author_email": "sean@baddaywithacamera.ca",
    "description": "A faithful visual reconstruction of Kubrick, Michael Heilemann's landmark WordPress theme. Its fixed white page, blue header, compact reading column, and right sidebar are rebuilt for SMACKTALK with modern responsive and accessibility support. Named STANLEY with gratitude.",
    "status": "stable",
    "modes": [
        "smacktalk"
    ],
    "skin_preload": "preload.php",
    "variants": {
        "default": "STANLEY (Classic Blue)"
    },
    "default_variant": "default",
    "cover_aspect": "4/3",
    "features": {
        "supports_wall": false,
        "archive_layouts": [
            "square",
            "cropped"
        ],
        "has_landing": false,
        "post_modes": [
            "longform"
        ],
        "instagram_mode": false,
        "carousel": false,
        "community": [
            "comments"
        ]
    },
    "require_scripts": [
        "smack-footer",
        "smack-community"
    ],
    "community_comments": "1",
    "community_likes": "0",
    "community_reactions": "0",
    "options": {
        "header_image": {
            "section": "HEADER",
            "type": "image",
            "label": "Header Banner Image",
            "default": "",
            "accept": "image/jpeg,image/png,image/webp",
            "help": "Optional photo for Kubrick's blue header position. Recommended 1260x300px. Leave blank for the faithful blue gradient.",
            "hint": "Recommended 1260x300px. Leave blank for the classic blue gradient."
        },
        "header_logo": {
            "section": "HEADER",
            "type": "image",
            "label": "Custom Logo",
            "default": "",
            "accept": "image/jpeg,image/png,image/webp,image/svg+xml",
            "help": "Upload a logo to replace the site title text in the banner. Transparent PNG recommended.",
            "hint": "Transparent PNG recommended."
        },
        "show_tagline": {
            "section": "HEADER",
            "type": "select",
            "label": "Show Tagline",
            "default": "1",
            "options": {
                "1": "Show",
                "0": "Hide"
            },
            "help": "Hide the tagline under the banner (useful when your logo already includes it). Still used in RSS and social/SEO meta."
        },
        "accent_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Unvisited Link Colour",
            "default": "#0066cc",
            "selector": ":root",
            "property": "--stanley-accent",
            "help": "The normal colour for links that have not been visited."
        },
        "visited_link_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Visited Link Colour",
            "default": "#b85b5a",
            "selector": ":root",
            "property": "--stanley-link-visited"
        },
        "hover_link_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Hover / Focus Link Colour",
            "default": "#114477",
            "selector": ":root",
            "property": "--stanley-link-hover"
        },
        "active_link_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Active Link Colour",
            "default": "#cc3300",
            "selector": ":root",
            "property": "--stanley-link-active",
            "help": "The colour while a link is being clicked or tapped."
        },
        "banner_top_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Header Banner — Top",
            "default": "#69aee6",
            "selector": ":root",
            "property": "--stanley-banner-top"
        },
        "banner_bottom_color": {
            "section": "COLOURS",
            "type": "color",
            "label": "Header Banner — Bottom",
            "default": "#0066cc",
            "selector": ":root",
            "property": "--stanley-banner-bottom",
            "help": "Together with the top colour, replaces Kubrick's classic blue gradient."
        },
        "show_sidebar": {
            "section": "LAYOUT",
            "type": "select",
            "label": "Show Sidebar",
            "default": "1",
            "options": {
                "1": "Yes (Kubrick two-column)",
                "0": "No (single column)"
            },
            "help": "The right-hand sidebar with recent posts and pages, as in the original."
        },
        "post_content_width": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Reading Column Width (px)",
            "default": "760",
            "min": "600",
            "max": "900",
            "selector": ".post-inner",
            "property": "width",
            "unit": "px"
        },
        "posts_per_page": {
            "section": "LAYOUT",
            "type": "range",
            "label": "Posts Per Page",
            "default": "10",
            "min": "4",
            "max": "40"
        }
    }
}
