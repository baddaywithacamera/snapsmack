# SECAUDIT 008 (masthead-logo-upload MIME bypass): this directory holds static
# branding images only. A file placed here via an upload MIME bypass must NEVER
# be executed as a script. Disable all server-side execution.

# Classic mod_php kill-switch (Apache 2.2/2.4 with mod_php).
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_admin_flag engine off
</IfModule>

# Strip any handler/type that could run code, and serve such files as text.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
AddType text/plain .php .phtml .phar

# Belt and suspenders: refuse to serve known executable extensions at all.
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pht|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
