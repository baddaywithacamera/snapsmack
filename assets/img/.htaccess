# SNAPSMACK-UPLOAD-EXECUTION-GUARD
# Uploaded files are data, never server-side programs.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .cgi .pl
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pht|cgi|pl)$">
  SetHandler none
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>
