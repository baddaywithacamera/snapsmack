# ─────────────────────────────────────────────────────────────
# SNAPSMACK-HTACCESS-RULES
# Do not remove the marker above — the installer and repair
# tool use it to detect whether these rules are present.
# This block is rebuilt verbatim from core/htaccess-template
# whenever you click REPAIR in System Maintenance, so edit the
# template (in git) rather than the live file.
# ─────────────────────────────────────────────────────────────

# ─── FORCE HTTPS ─────────────────────────────────────────────
# Redirects HTTP → HTTPS. Safe behind Cloudflare Tunnel and any
# other SSL-terminating reverse proxy: the X-Forwarded-Proto
# check prevents redirect loops when the edge already speaks
# HTTPS to the visitor and plain HTTP to the origin.
RewriteEngine On
# ─── API AUTHORIZATION PASSTHROUGH ──────────────────────────────────────────
# Apache FastCGI/PHP-FPM strips the Authorization header by default.
# Without this, $_SERVER['HTTP_AUTHORIZATION'] is always empty and all
# Bearer-token API auth (Unzucker, Oh Snap!, etc.) silently fails.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ─── PHP LIMITS ──────────────────────────────────────────────
# 64MB uploads for high-res photography, 128MB memory for
# image processing and backup operations.
php_value upload_max_filesize 64M
php_value post_max_size 64M
php_value memory_limit 128M
php_value max_execution_time 120

# ─── DEV DIRECTORIES — NEVER WEB-SERVED (SECAUDIT 055) ──────
# Regression tests, dev scratch, and release-packaging tooling
# have no business answering web requests on an install. Old
# release packages shipped these fleet-wide; until the updater
# has removed them from disk, this returns 404 for the whole
# subtree (404, not 403, so probes learn nothing). Keep the list
# in lockstep with UPDATER_DEPRECATED_DIRS + SMACKBACK dev dirs.
RewriteRule ^(tests|wip|smack-central|core/tests)(/|$) - [R=404,L]

# Skin templates and CMS internals are include-only PHP. Refuse direct HTTP
# execution at the server before routing; the in-file guard below skins/ is an
# independent second layer for hosts that ignore .htaccess.
RewriteRule ^(?:skins|core)(?:/.*)?\.php$ - [R=404,L,NC]

# ─── CLEAN URL ROUTER ────────────────────────────────────────
RewriteBase /

# Don't rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Named routes
RewriteRule ^archive$ archive.php [L,QSA]
RewriteRule ^rss$ rss.php [L,QSA]
RewriteRule ^feed$ rss.php [L,QSA]
RewriteRule ^snap-in$ snap-in.php [L,QSA]
RewriteRule ^app/?$ smack-app.php [L,QSA]
RewriteRule ^api/desktop-auth/(activate|enroll|status|renew)/?$ api.php?route=desktop-auth/$1 [L,QSA]
RewriteRule ^api/v([12])/(.*)$ pixelfed-api.php?route=api/v$1/$2 [L,QSA]
RewriteRule ^api/v1\.1/(.*)$ pixelfed-api.php?route=api/v1.1/$1 [L,QSA]
RewriteRule ^api/pixelfed/v1/(.*)$ pixelfed-api.php?route=api/pixelfed/v1/$1 [L,QSA]
RewriteRule ^oauth/(authorize|token|revoke)$ pixelfed-api.php?route=oauth/$1 [L,QSA]
RewriteRule ^collections$ collections.php [L,QSA]
RewriteRule ^collection/([a-zA-Z0-9_-]+)$ collection.php?slug=$1 [L,QSA]
# FEDIVERSE (ActivityPub) — WebFinger discovery. Mastodon/Pixelfed hit
# /.well-known/webfinger to resolve @handle@domain. The endpoint 404s on its
# own unless fediverse_enabled=1, so this rewrite is harmless while off.
RewriteRule ^\.well-known/webfinger$ fediverse.php?ap=webfinger [L,QSA]
# FEDIVERSE (ActivityPub) — NodeInfo discovery. Directory crawlers (FediList,
# fediverse.observer) and some peers read /.well-known/nodeinfo → /nodeinfo/2.0
# to identify the software/version. 404s while fediverse_enabled=0, like above.
RewriteRule ^\.well-known/nodeinfo$ fediverse.php?ap=nodeinfo [L,QSA]
RewriteRule ^nodeinfo/2\.0$ fediverse.php?ap=nodeinfo2 [L,QSA]
# FEDIVERSE (ActivityPub) — path-style object routes (/ap/actor, /ap/note/p/N…).
# AP ids must be query-string-free: Pixelfed HTML-encodes '&' when it fetches
# object URLs, so ?a=1&b=2 ids 404 on their side. Harmless while off.
RewriteRule ^ap/(.+)$ fediverse.php?appath=$1 [L,QSA]
RewriteRule ^board/?$ photochallenge-board.php [L,QSA]
RewriteRule ^challenge-feed/?$ photochallenge-board.php [L,QSA]
RewriteRule ^hall-of-fame/?$ photochallenge-hof.php [L,QSA]

# Everything else → index.php (image slugs, static pages)
RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?name=$1 [L,QSA]

# ─── SECURITY HEADERS ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS + CSP were sent only by core/http-security-headers.php, and on many
    # sites that PHP step was skipped for some responses (fleet check 2026-09-26:
    # 12 of 28 sites without them, varying from one check to the next). The web
    # server now sends them on every response too. Same values as the PHP file.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    <FilesMatch "\.(sql|log|bak|inc|sh|env|json|sbc)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# ─── BLOCK SENSITIVE FILES ───────────────────────────────────
<FilesMatch "(^\.ht|\.sql$|\.log$|\.bak$|\.inc$|\.sh$|\.env$|\.sbc$|^smackback-manifest\.json$)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block direct access to core PHP includes (SECAUDIT 050-B — reconciled to real
# filenames). Dropped 'login' and 'auth' (no login.php / auth.php exist on dev —
# the real auth include is auth-smack.php, now listed). This Apache rule is the
# belt; each of these files also carries a server-agnostic PHP direct-access guard
# (the suspenders), so protection no longer depends on Apache alone.
<FilesMatch "^(db|auth-smack|constants|release-pubkey|updater|skin-registry|manifest-inventory)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ─── NO DIRECTORY LISTINGS ───────────────────────────────────
Options -Indexes

# ─── PROBE GUARD ─────────────────────────────────────────────
# Route known scanner/exploit paths to probe-ban.php, which
# logs a 30-day IP ban. This is what feeds the IP Smacker
# auto-ban list — without this rule, scanner traffic doesn't
# get caught.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(wp-login\.php|wp-admin|xmlrpc\.php|\.env|\.git/config|phpmyadmin|pma|adminer|shell\.php|c99\.php|r57\.php|eval-stdin\.php|uploadify\.php|setup\.php|config\.php\.bak|install\.php\.bak|wp-config\.php|wp-includes|wp-content|\.DS_Store|cgi-bin|actuator|\.aws|\.ssh|boaform|solr|hudson)(.*)$ probe-ban.php [L]

# ─── STATIC ASSET CACHING ────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/ttf "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
</IfModule>

# ─── GZIP COMPRESSION ────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ─── CUSTOM ERROR PAGES ──────────────────────────────────────
ErrorDocument 404 /error404.php
ErrorDocument 500 /error500.php
