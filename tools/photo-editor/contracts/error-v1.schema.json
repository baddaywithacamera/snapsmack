{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapsmack.ca/contracts/photo-editor/error-v1.schema.json",
  "title": "SnapSmack Photo Editor Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "message": { "type": "string" },
    "details": { "type": "object" }
  }
}
