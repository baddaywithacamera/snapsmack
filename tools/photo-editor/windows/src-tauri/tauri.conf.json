{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIXEL TICKLER",
  "version": "0.1.0",
  "identifier": "ca.snapsmack.photo-editor",
  "build": { "frontendDist": "../../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "PIXEL TICKLER", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 600, "center": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": false }
}
