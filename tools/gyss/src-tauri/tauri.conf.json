{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GET YOUR SHIT SORTED",
  "version": "0.1.5-alpha",
  "identifier": "ca.snapsmack.gyss",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "GET YOUR SHIT SORTED",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-aNkw9ThUtD7eiGbFBeA6FQ67Ztb9JevlFf+t/UKYwwE='; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https: http:; connect-src 'self' ipc: http://ipc.localhost https: http:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["C:/snapsmack/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
