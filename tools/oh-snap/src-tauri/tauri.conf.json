{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oh Snap!",
  "version": "0.2.0",
  "identifier": "ca.snapsmack.ohsnap",
  "build": {
    "beforeDevCommand": "npm run contract",
    "beforeBuildCommand": "npm run contract",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Oh Snap!",
        "width": 1400,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; script-src 'self'; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
