# -*- mode: python ; coding: utf-8 -*-
# FLKR FCKR build recipe — Qt shell (flkrfckr_launcher.py → flkrfckr_qt.py).
#
# COLLECT, NOT ONEFILE, AND THAT IS THE LICENCE. (SS-1195)
#
# This spec built a onefile exe with Qt inside it. Qt is used under the LGPLv3,
# which obliges whoever distributes the combined work to let a recipient replace
# the Qt libraries with their own build. A onefile exe unpacks itself to a
# temporary directory at run time, so its Qt libraries cannot be replaced and
# that obligation cannot be met by a recipient.
#
# MEASURED BEFORE CHANGING ANYTHING: no onefile build of this tool has ever been
# distributed. No build script in the tools tree uploads, copies out or
# publishes anything — checked for curl, scp, ftp, rsync, web requests and
# uploads, all absent. No tool page offers an executable, /downloads/ is 404,
# the release manifest carries only the CMS zip, and the release builder
# excludes the whole tools directory from it. The only copy that exists is on
# the build machine. So this was a recipe defect to fix before the file was ever
# sent to a person, NOT a breach.
#
# The output is now a DIRECTORY. build.bat copies the whole directory, and the
# exe keeps the name SNAP HQ launches it by (tools/hub/qt_main.py expects
# C:\snapsmack\flkr-fckr\flkr-fckr.exe), so the launcher is unaffected.
#
# FIVE OTHER TOOLS STILL BUILD THIS WAY — the backup tool (which also bundles an
# SSH library under LGPL-2.1 and a tray library under LGPLv3), the cold-storage
# tool, the file-sorting tool, the federation tool and the Blogger importer.
# They are in SS-1195 and are NOT changed here; only this one was authorised.
# Copied from tools/sybu/sybu.spec: every local .py and every tools/_shared/*.py
# is bundled (data copy + forced hidden import) so a module can never be
# silently dropped from the exe. version_info.txt (regenerated by
# bump_version.py) stamps the Windows file version; assets/icon.ico is the
# app icon — keep both or the exe ships unversioned / iconless.
import os, glob, sys
sys.setrecursionlimit(sys.getrecursionlimit() * 5)

_src = SPECPATH

_py_files   = glob.glob(os.path.join(_src, '*.py'))
_local_data = [(f, '.') for f in _py_files]
_local_mods = [os.path.splitext(os.path.basename(f))[0]
               for f in _py_files
               if os.path.basename(f) not in ('main.py', 'bump_version.py')]

_shared_dir   = os.path.normpath(os.path.join(_src, '..', '_shared'))
_shared_files = glob.glob(os.path.join(_shared_dir, '*.py'))
_shared_data  = [(f, '.') for f in _shared_files]
_shared_mods  = [os.path.splitext(os.path.basename(f))[0] for f in _shared_files]

# The LGPL text and the Qt notice must travel with a Qt build. Refusing to
# build without them is the same guard tools/unzucker/unzucker.spec carries: a
# missing licence file is not something to discover after shipping.
_license_dir = os.path.normpath(os.path.join(_src, '..', '..', 'licenses'))
for _required in ('LGPL-3.0.txt', 'Qt-PySide6-LGPLv3-NOTICE.txt'):
    if not os.path.isfile(os.path.join(_license_dir, _required)):
        raise SystemExit('flkrfckr.spec: licenses/%s is missing. Refusing to '
                         'build a Qt application without it.' % _required)

a = Analysis(
    ['flkrfckr_launcher.py'],
    pathex=[_src, _shared_dir],
    binaries=[],
    datas=_local_data + _shared_data + [(os.path.join(_src, 'assets'), 'assets'),
                                        (_license_dir, 'licenses')],
    hiddenimports=_local_mods + _shared_mods + [
        'PySide6', 'PySide6.QtCore', 'PySide6.QtGui', 'PySide6.QtWidgets',
        'PIL', 'PIL.Image',
        'requests',
        # credential vault (SECAUDIT 040 finding A) — keyring picks its backend
        # at runtime, so static analysis misses every backend without this.
        'cryptography', 'keyring', 'keyring.backends',
        'keyring.backends.Windows', 'keyring.backends.chainer',
        'keyring.backends.fail', 'keyring.backends.null',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        'tkinter', 'PIL.ImageTk', 'PIL._tkinter_finder',
        'torch', 'tensorflow', 'scipy', 'sklearn', 'matplotlib', 'pandas',
        'numpy.distutils', 'IPython', 'notebook',
    ],
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    # NAMED flkr-fckr, NOT flkrfckr, on purpose. The onefile build produced
    # dist\flkrfckr.exe and build.bat renamed it on the way to
    # C:\snapsmack\flkr-fckr\flkr-fckr.exe, which is the path
    # tools/hub/qt_main.py launches. A COLLECT directory is copied wholesale and
    # nothing renames anything inside it, so the exe has to carry the final name
    # here or SNAP HQ's launcher stops finding it.
    name='flkr-fckr',
    contents_directory='.',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=os.path.join(_src, 'assets', 'icon.ico'),
    version=os.path.join(_src, 'version_info.txt'),
)

# Never collapse this back to onefile: the dynamic Qt libraries must stay
# separately inspectable and relinkable in the distributed directory, which is
# what the LGPLv3 asks of us. licenses/ ships beside them.
app = COLLECT(exe, a.binaries, a.datas, strip=False, upx=False, name='flkrfckr')
# ===== SNAPSMACK EOF =====
