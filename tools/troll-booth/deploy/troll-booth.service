[Unit]
Description=SnapSmack TROLL BOOTH remote MCP adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trollbooth
Group=trollbooth
WorkingDirectory=/opt/snapsmack/troll-booth/current
EnvironmentFile=/etc/troll-booth/server.env
ExecStart=/opt/snapsmack/troll-booth/venv/bin/troll-booth-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/troll-booth
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target

