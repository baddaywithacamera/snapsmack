# Copy to /etc/troll-booth/server.env, restrict it to the service account,
# and replace every CHANGE_ME value locally. Never commit the completed file.
TROLL_BOOTH_PUBLIC_URL=https://trollbooth.example.invalid
TROLL_BOOTH_BIND=127.0.0.1
TROLL_BOOTH_PORT=8765
TROLL_BOOTH_DATABASE=/var/lib/troll-booth/remote.sqlite3
TROLL_BOOTH_WORKER_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
